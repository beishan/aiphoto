# 将此文件填写后作为 Jenkins Secret file 上传，凭据 ID: memoryvault-production-env
# 不要提交包含真实密码的 .env.production。
DB_PASSWORD=请替换为强数据库密码
REDIS_PASSWORD=请替换为强Redis密码
RABBITMQ_PASSWORD=请替换为强RabbitMQ密码
MINIO_USER=memoryvault
MINIO_PASSWORD=请替换为强MinIO密码
JWT_SECRET=请替换为至少32字节的随机JWT密钥
TZ=Asia/Shanghai

# 以下均是飞牛 NAS Docker 宿主机的绝对路径。
# 后端中请使用 /photos 作为扫描目录。
PHOTO_LIBRARY_PATH=/vol1/photos
# 目录下必须包含 insightface/models、ultralytics、clip、chinese-clip。
AI_MODELS_PATH=/vol1/docker/memoryvault/ai-models

FRONTEND_PORT=8391
BACKEND_PORT=8392
MINIO_API_PORT=9300
MINIO_CONSOLE_PORT=9301
RABBITMQ_MGMT_PORT=15682

CUDA_VISIBLE_DEVICES=0
JAVA_OPTS=-Xms512m -Xmx2g
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3
