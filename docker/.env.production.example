# 将此文件填写后作为 Jenkins Secret file 上传，凭据 ID: memoryvault-production-env
# 不要提交包含真实密码的 .env.production。
DB_PASSWORD=请替换为强数据库密码
JWT_SECRET=请替换为至少32字符的随机JWT密钥(纯文本,无需Base64)
TZ=Asia/Shanghai

# 以下是飞牛 NAS Docker 宿主机的绝对路径。
# Jenkins 构建参数中的同名值会覆盖这里的默认值。
# 后端中请使用 /photos 作为扫描目录。
PHOTO_LIBRARY_PATH=/vol1/photos
# 模型统一由设置页管理；目录需对运行 Docker 的用户可读写。
# 建议预置 chinese-clip、insightface/models、ultralytics 等子目录。
AI_MODELS_PATH=/vol1/docker/aiphoto/ai-models
# 上传照片和缩略图的持久化目录。
STORAGE_DATA_PATH=/vol1/docker/aiphoto/storage

FRONTEND_PORT=8391
BACKEND_PORT=8392
CUDA_VISIBLE_DEVICES=0
# Jenkins 中的 ENABLE_GPU 参数会覆盖此值。
ENABLE_GPU=false
JAVA_OPTS=-Xms512m -Xmx2g
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3

# 镜像源持续故障时可改为 docker.io/pgvector/pgvector:pg16 或可访问的镜像源。
POSTGRES_BASE_IMAGE=docker.m.daocloud.io/pgvector/pgvector:pg16

# 前端构建镜像源可独立覆盖，例如 docker.io/library/nginx:alpine。
FRONTEND_NODE_BASE_IMAGE=docker.m.daocloud.io/library/node:20-alpine
FRONTEND_NGINX_BASE_IMAGE=docker.m.daocloud.io/library/nginx:alpine
